import ZipperGenParallel.Alphabet

namespace ZipperGenParallel

universe u v w

/-- Local successor edge on a lifeline, using one-based local indices. -/
def LocalSucc {Lifeline : Type u} {Event : Type w}
    (lifeline : Event → Lifeline) (localIndex : Event → Nat)
    (e f : Event) : Prop :=
  lifeline e = lifeline f ∧ localIndex f = localIndex e + 1

/-- The one-step causal edges of an MSC: local successor or message edge. -/
def BaseEdge {Lifeline : Type u} {Event : Type w}
    (lifeline : Event → Lifeline) (localIndex : Event → Nat)
    (msg : Event → Event → Prop) (e f : Event) : Prop :=
  LocalSucc lifeline localIndex e f ∨ msg e f

/--
Channel-aware MSC structure.

The causal order is generated by local successor edges and message edges,
as in the paper.  The structure stores the data and properties needed for
matching, one-based local indices, and channel-sensitive FIFO.
-/
structure MSC (Lifeline : Type u) (Channel : Type v) (Event : Type w) where
  lifeline : Event → Lifeline
  kind : Event → EventKind Lifeline Channel
  localIndex : Event → Nat
  localIndex_pos : ∀ e, 0 < localIndex e
  localIndex_inj :
    ∀ {e f}, lifeline e = lifeline f → localIndex e = localIndex f → e = f
  msg : Event → Event → Prop
  msg_send_recv :
    ∀ {s r}, msg s r →
      ∃ A B ch,
        lifeline s = A ∧ lifeline r = B ∧
        kind s = EventKind.send B ch ∧
        kind r = EventKind.recv A ch
  msg_lifeline_ne :
    ∀ {s r}, msg s r → lifeline s ≠ lifeline r
  msg_send_unique :
    ∀ {s r₁ r₂}, msg s r₁ → msg s r₂ → r₁ = r₂
  msg_recv_unique :
    ∀ {s₁ s₂ r}, msg s₁ r → msg s₂ r → s₁ = s₂
  recv_matched :
    ∀ {r}, (∃ A ch, kind r = EventKind.recv A ch) → ∃ s, msg s r
  acyclic : Acyclic (BaseEdge lifeline localIndex msg)
  channel_fifo :
    ∀ {s₁ s₂ r₁ r₂ A B ch},
      msg s₁ r₁ → msg s₂ r₂ →
      lifeline s₁ = A → lifeline s₂ = A →
      lifeline r₁ = B → lifeline r₂ = B →
      kind s₁ = EventKind.send B ch →
      kind s₂ = EventKind.send B ch →
      kind r₁ = EventKind.recv A ch →
      kind r₂ = EventKind.recv A ch →
      localIndex s₁ < localIndex s₂ →
      localIndex r₁ < localIndex r₂

namespace MSC

variable {Lifeline : Type u} {Channel : Type v} {Event : Type w}

def IsSend (M : MSC Lifeline Channel Event) (e : Event) : Prop :=
  ∃ B ch, M.kind e = EventKind.send B ch

def IsRecv (M : MSC Lifeline Channel Event) (e : Event) : Prop :=
  ∃ A ch, M.kind e = EventKind.recv A ch

/-- The strict causal order of an MSC. -/
def strictCausal (M : MSC Lifeline Channel Event) (e f : Event) : Prop :=
  Relation.TransGen (BaseEdge M.lifeline M.localIndex M.msg) e f

/-- The non-strict causal order of an MSC. -/
def causal (M : MSC Lifeline Channel Event) (e f : Event) : Prop :=
  e = f ∨ strictCausal M e f

theorem local_succ_causal (M : MSC Lifeline Channel Event) {e f : Event}
    (h : LocalSucc M.lifeline M.localIndex e f) :
    strictCausal M e f :=
  Relation.TransGen.single (Or.inl h)

theorem msg_causal (M : MSC Lifeline Channel Event) {s r : Event}
    (h : M.msg s r) : strictCausal M s r :=
  Relation.TransGen.single (Or.inr h)

/-- A complete MSC has no unmatched sends. -/
def IsComplete (M : MSC Lifeline Channel Event) : Prop :=
  ∀ s, IsSend M s → ∃ r, M.msg s r

/-- The events of a lifeline. -/
def OnLifeline (M : MSC Lifeline Channel Event) (A : Lifeline) (e : Event) :
    Prop :=
  M.lifeline e = A

/--
Restrict an MSC to a subset of events that is closed under receive matching.

The local indices are inherited from the enclosing MSC.  This generic
restriction lemma is the structural core needed for branch restriction: once a
branch-local event set is shown to contain the matching send for every receive
it contains, the MSC properties are inherited from the enclosing MSC.
-/
def restrict (M : MSC Lifeline Channel Event) (keep : Event → Prop)
    (recv_closed :
      ∀ {r}, keep r → (∃ A ch, M.kind r = EventKind.recv A ch) →
        ∃ s, keep s ∧ M.msg s r) :
    MSC Lifeline Channel {e : Event // keep e} where
  lifeline e := M.lifeline e.val
  kind e := M.kind e.val
  localIndex e := M.localIndex e.val
  localIndex_pos e := M.localIndex_pos e.val
  localIndex_inj := by
    intro e f hline hindex
    apply Subtype.ext
    exact M.localIndex_inj hline hindex
  msg s r := M.msg s.val r.val
  msg_send_recv := by
    intro s r hmsg
    exact M.msg_send_recv hmsg
  msg_lifeline_ne := by
    intro s r hmsg
    exact M.msg_lifeline_ne hmsg
  msg_send_unique := by
    intro s r₁ r₂ h₁ h₂
    apply Subtype.ext
    exact M.msg_send_unique h₁ h₂
  msg_recv_unique := by
    intro s₁ s₂ r h₁ h₂
    apply Subtype.ext
    exact M.msg_recv_unique h₁ h₂
  recv_matched := by
    intro r hrecv
    rcases recv_closed r.property hrecv with ⟨s, hskeep, hmsg⟩
    exact ⟨⟨s, hskeep⟩, hmsg⟩
  acyclic := by
    intro e hcycle
    have hbase :
        ∀ {x y : {e : Event // keep e}},
          BaseEdge (fun z => M.lifeline z.val) (fun z => M.localIndex z.val)
              (fun z w => M.msg z.val w.val) x y →
          BaseEdge M.lifeline M.localIndex M.msg x.val y.val := by
      intro x y h
      rcases h with hlocal | hmsg
      · exact Or.inl hlocal
      · exact Or.inr hmsg
    have transgen_map :
        ∀ {x y : {e : Event // keep e}},
          Relation.TransGen
            (BaseEdge (fun z => M.lifeline z.val) (fun z => M.localIndex z.val)
              (fun z w => M.msg z.val w.val)) x y →
          Relation.TransGen (BaseEdge M.lifeline M.localIndex M.msg)
            x.val y.val := by
      intro x y hpath
      induction hpath with
      | single h =>
          exact Relation.TransGen.single (hbase h)
      | tail _ h ih =>
          exact Relation.TransGen.tail ih (hbase h)
    have hcycleM :
        Relation.TransGen (BaseEdge M.lifeline M.localIndex M.msg)
          e.val e.val :=
      transgen_map hcycle
    exact M.acyclic e.val hcycleM
  channel_fifo := by
    intro s₁ s₂ r₁ r₂ A B ch hmsg₁ hmsg₂ hs₁ hs₂ hr₁ hr₂ hks₁ hks₂ hkr₁ hkr₂ hlt
    exact M.channel_fifo hmsg₁ hmsg₂ hs₁ hs₂ hr₁ hr₂ hks₁ hks₂ hkr₁ hkr₂ hlt

theorem restrict_complete (M : MSC Lifeline Channel Event) (keep : Event → Prop)
    (recv_closed :
      ∀ {r}, keep r → (∃ A ch, M.kind r = EventKind.recv A ch) →
        ∃ s, keep s ∧ M.msg s r)
    (send_closed : ∀ {s r}, keep s → M.msg s r → keep r)
    (hcomplete : M.IsComplete) :
    (M.restrict keep recv_closed).IsComplete := by
  intro s hsend
  rcases hcomplete s.val hsend with ⟨r, hmsg⟩
  exact ⟨⟨r, send_closed s.property hmsg⟩, hmsg⟩

end MSC

/--
An event occurrence in a tuple of local words.

The event stores its owner lifeline and its zero-based position in that
lifeline's word.  The MSC local index is the corresponding one-based position.
-/
structure WordEvent {Lifeline : Type u} {Channel : Type v}
    (words : Lifeline → Word (LocalLetter Lifeline Channel)) where
  owner : Lifeline
  index : Nat
  inBounds : index < (words owner).length

namespace WordEvent

variable {Lifeline : Type u} {Channel : Type v}
variable {words : Lifeline → Word (LocalLetter Lifeline Channel)}

def letter (e : WordEvent words) : LocalLetter Lifeline Channel :=
  (words e.owner).get ⟨e.index, e.inBounds⟩

def kind (e : WordEvent words) : EventKind Lifeline Channel :=
  LocalLetter.toEventKind e.letter

def localIndex (e : WordEvent words) : Nat :=
  e.index + 1

theorem localIndex_pos (e : WordEvent words) :
    0 < e.localIndex := by
  exact Nat.succ_pos e.index

theorem localIndex_inj {e f : WordEvent words}
    (hline : e.owner = f.owner)
    (hindex : e.localIndex = f.localIndex) :
    e = f := by
  cases e with
  | mk owner index inBounds =>
      cases f with
      | mk owner' index' inBounds' =>
          dsimp [localIndex] at hindex
          dsimp at hline
          subst owner'
          have hidx : index = index' := Nat.succ.inj hindex
          subst index'
          simp

end WordEvent

/--
Message matching and MSC side conditions for a tuple of local words.

This is the concrete word-to-MSC interface: events are fixed as occurrences in
the local words, while the matching relation is supplied together with the
standard MSC obligations.
-/
structure WordMSCData {Lifeline : Type u} {Channel : Type v}
    (words : Lifeline → Word (LocalLetter Lifeline Channel)) where
  msg : WordEvent words → WordEvent words → Prop
  msg_send_recv :
    ∀ {s r}, msg s r →
      ∃ A B ch,
        s.owner = A ∧ r.owner = B ∧
        s.kind = EventKind.send B ch ∧
        r.kind = EventKind.recv A ch
  msg_letter_match :
    ∀ {s r}, msg s r →
      LocalLetter.MessageMatches s.owner r.owner s.letter r.letter
  msg_lifeline_ne :
    ∀ {s r}, msg s r → s.owner ≠ r.owner
  msg_send_unique :
    ∀ {s r₁ r₂}, msg s r₁ → msg s r₂ → r₁ = r₂
  msg_recv_unique :
    ∀ {s₁ s₂ r}, msg s₁ r → msg s₂ r → s₁ = s₂
  recv_matched :
    ∀ {r}, (∃ A ch, r.kind = EventKind.recv A ch) → ∃ s, msg s r
  acyclic :
    Acyclic
      (BaseEdge
        (fun e : WordEvent words => e.owner)
        (fun e : WordEvent words => e.localIndex)
        msg)
  channel_fifo :
    ∀ {s₁ s₂ r₁ r₂ A B ch},
      msg s₁ r₁ → msg s₂ r₂ →
      s₁.owner = A → s₂.owner = A →
      r₁.owner = B → r₂.owner = B →
      s₁.kind = EventKind.send B ch →
      s₂.kind = EventKind.send B ch →
      r₁.kind = EventKind.recv A ch →
      r₂.kind = EventKind.recv A ch →
      s₁.localIndex < s₂.localIndex →
      r₁.localIndex < r₂.localIndex

namespace WordMSCData

variable {Lifeline : Type u} {Channel : Type v}
variable {words : Lifeline → Word (LocalLetter Lifeline Channel)}

def toMSC (D : WordMSCData words) :
    MSC Lifeline Channel (WordEvent words) where
  lifeline e := e.owner
  kind e := e.kind
  localIndex e := e.localIndex
  localIndex_pos := WordEvent.localIndex_pos
  localIndex_inj := by
    intro e f hline hindex
    exact WordEvent.localIndex_inj hline hindex
  msg := D.msg
  msg_send_recv := D.msg_send_recv
  msg_lifeline_ne := D.msg_lifeline_ne
  msg_send_unique := D.msg_send_unique
  msg_recv_unique := D.msg_recv_unique
  recv_matched := D.recv_matched
  acyclic := D.acyclic
  channel_fifo := D.channel_fifo

def IsComplete (D : WordMSCData words) : Prop :=
  (D.toMSC).IsComplete

theorem ctrl_kind_eq_of_msg {D : WordMSCData words}
    {s r : WordEvent words} {chSend chRecv : Channel}
    {tagSend tagRecv : ControlTag}
    {kindSend kindRecv : ChoiceKind}
    (hmsg : D.msg s r)
    (hs :
      s.letter = LocalLetter.ctrlSend r.owner chSend tagSend kindSend)
    (hr :
      r.letter = LocalLetter.ctrlRecv s.owner chRecv tagRecv kindRecv) :
    kindSend = kindRecv := by
  have hmatch := D.msg_letter_match hmsg
  have hmatch' :
      LocalLetter.MessageMatches s.owner r.owner
        (LocalLetter.ctrlSend r.owner chSend tagSend kindSend)
        (LocalLetter.ctrlRecv s.owner chRecv tagRecv kindRecv) := by
    simpa [hs, hr] using hmatch
  exact
    (LocalLetter.messageMatches_ctrl_kind_eq
      (sender := s.owner)
      (receiver := r.owner)
      (chSend := chSend)
      (chRecv := chRecv)
      (tagSend := tagSend)
      (tagRecv := tagRecv)
      (kindSend := kindSend)
      (kindRecv := kindRecv)
      hmatch')

theorem ctrl_tag_eq_of_msg {D : WordMSCData words}
    {s r : WordEvent words} {chSend chRecv : Channel}
    {tagSend tagRecv : ControlTag}
    {kindSend kindRecv : ChoiceKind}
    (hmsg : D.msg s r)
    (hs :
      s.letter = LocalLetter.ctrlSend r.owner chSend tagSend kindSend)
    (hr :
      r.letter = LocalLetter.ctrlRecv s.owner chRecv tagRecv kindRecv) :
    tagSend = tagRecv := by
  have hmatch := D.msg_letter_match hmsg
  have hmatch' :
      LocalLetter.MessageMatches s.owner r.owner
        (LocalLetter.ctrlSend r.owner chSend tagSend kindSend)
        (LocalLetter.ctrlRecv s.owner chRecv tagRecv kindRecv) := by
    simpa [hs, hr] using hmatch
  exact
    (LocalLetter.messageMatches_ctrl_tag_eq
      (sender := s.owner)
      (receiver := r.owner)
      (chSend := chSend)
      (chRecv := chRecv)
      (tagSend := tagSend)
      (tagRecv := tagRecv)
      (kindSend := kindSend)
      (kindRecv := kindRecv)
      hmatch')

end WordMSCData

def WordIsMSC {Lifeline : Type u} {Channel : Type v}
    (words : Lifeline → Word (LocalLetter Lifeline Channel)) : Prop :=
  ∃ _D : WordMSCData words, True

def WordIsCompleteMSC {Lifeline : Type u} {Channel : Type v}
    (words : Lifeline → Word (LocalLetter Lifeline Channel)) : Prop :=
  ∃ D : WordMSCData words, D.IsComplete

theorem WordIsCompleteMSC.toMSC {Lifeline : Type u} {Channel : Type v}
    {words : Lifeline → Word (LocalLetter Lifeline Channel)}
    (h : WordIsCompleteMSC words) :
    WordIsMSC words := by
  rcases h with ⟨D, _hcomplete⟩
  exact ⟨D, trivial⟩

end ZipperGenParallel
